# Generate locally: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Never commit the resulting .env or key; back up the key separately from the DB.
HOOD_VAULT_KEY=
HOOD_DATA_DIR=.private
# Optional alternative: a deployment-generated random secret (at least 32 chars).
# Render generates this securely. Do not use a human password. Never set both keys.
HOOD_VAULT_SECRET=
# Backend browser OAuth + configured watch build: private backend's HTTPS origin.
# On Render the backend defaults to its assigned RENDER_EXTERNAL_URL.
HOOD_BACKEND_URL=https://hood.example.com
