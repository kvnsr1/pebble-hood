# Generate locally: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Never commit the resulting .env or key; back up the key separately from the DB.
HOOD_VAULT_KEY=
HOOD_DATA_DIR=.private
# Used only by the watch build. Must be your private backend's public HTTPS origin.
HOOD_BACKEND_URL=https://hood.example.com
